# Local Strands Decider inference server. Start it separately before choosing it in the UI.
STRANDS_DECIDER_URL=http://127.0.0.1:8000
STRANDS_DECIDER_TIMEOUT_SECONDS=120

# Optional Amazon Bedrock settings. Use AWS CLI credentials or an IAM role;
# never put AWS access keys in this file.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
